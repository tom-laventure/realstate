---
import { CTA_URLS } from '../consts'
---

<section class="bg-background px-4 py-12 text-center lg:py-16">
	<div class="mx-auto max-w-2xl">
		<h2 class="text-foreground mb-4 text-[28px] font-semibold leading-[1.2]">
			Run your brokerage from one place, not five.
		</h2>
		<p class="text-muted-foreground mb-8 text-base leading-[1.6]">
			Listings sync automatically from your connected MLS/RETS board. Agents collaborate inside
			shared groups. Owners and admins control exactly who can see and manage what. It's one
			connected workspace, built for how brokerages actually operate — not a bundle of
			disconnected tools.
		</p>
		<a
			id="value-prop-get-started"
			href={CTA_URLS.getStarted}
			class="bg-primary text-primary-foreground inline-block rounded-md px-6 py-4 text-sm font-semibold transition-opacity hover:opacity-90 motion-reduce:transition-none"
		>
			Get Started
		</a>
	</div>
</section>

<script>
  import { track } from '@vercel/analytics'
  document.getElementById('value-prop-get-started')?.addEventListener('click', () => {
    track('get_started_click', { location: 'value_prop' })
  })
</script>
