---
import { CTA_URLS } from '../consts'
---

<section class="bg-background px-4 py-16 text-center">
	<div class="mx-auto max-w-2xl">
		<h2 class="text-foreground mb-4 text-[28px] font-semibold leading-[1.2]">
			Ready to bring your brokerage into one workspace?
		</h2>
		<p class="text-muted-foreground mb-8 text-base leading-[1.6]">
			Get started in minutes — no credit card, no sales call.
		</p>
		<a
			href={CTA_URLS.getStarted}
			class="bg-primary text-primary-foreground inline-block rounded-md px-6 py-4 text-sm font-semibold transition-opacity hover:opacity-90 motion-reduce:transition-none"
		>
			Get Started
		</a>
		<p class="mt-4 text-sm">
			<a
				href={CTA_URLS.login}
				class="text-foreground font-semibold underline-offset-2 hover:underline"
			>
				Already have an account? Log in
			</a>
		</p>
	</div>
</section>
